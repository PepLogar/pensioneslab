  "units": {
    "suffixBillionEUR": "Miles de millones de euros corrientes del año indicado; multiplicar por 1e9 para euros.",
    "suffixBillion2015EUR": "Miles de millones de euros a precios de 2015.",
    "suffixGDPpct": "Porcentaje del PIB nominal de la misma edición: 2.5 significa 2,5%, no 0,025.",
