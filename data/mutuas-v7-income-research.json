  "bridge2026": {
    "status": "proposed allocation of the existing opening estimate, not observed full-year income",
    "systemEstimateMEUR": 190173.35267629754,
    "systemEstimateFormula": "176918 * 126032.44 / 117247.80; retains the existing rounded 2025 anchor",
    "mutuasShareObservedJanAug": 0.10793570290315731,
    "mutuasEstimateMEUR": 20526.494494566206,
    "tgssEstimateMEUR": 169646.8581817313,
    "tgssOrdinaryRGShare": 0.8557106915557366,
    "tgssOrdinaryRETAShare": 0.07498265644797594,
    "tgssOrdinaryDenominatorJanAugMEUR": 108354.39,
    "mutuasCommonRGShare": 0.29469617889645233,
    "mutuasCessationShare": 0.02004204831145155,
    "mutuasProfessionalShare": 0.641800579266948,
    "tgssDenominatorExcludesRubric120MEIAndSolidarity": true,
    "allocationCreatesAdditionalConsolidatedRevenue": false,
    "note": "MEI and solidarity are kept in TGSS and must retain their existing distinct treatment. No blanket RG ceiling is identified for professional-contingency receipts."
  },
  "classificationDecisions": [
    "The aggregate system contribution total equals TGSS plus mutual collaborating institutions exactly at published precision in both periods.",
    "Rubric 1282, contributions paid by mutual institutions for beneficiaries, is not the contribution income assigned to mutual institutions.",
    "Common-contingency fractions assigned to mutual institutions fund temporary incapacity; cessation contributions are not pension contributions.",
    "Professional-contingency receipts also finance permanent-disability and survivor pension capital costs/reinsurance. They cannot all be treated as disposable retirement contributions or as unrelated to public pensions.",
    "Transfers from Social Security and transfers between public subsectors are internal at the appropriate consolidation boundary; do not add them to AAPP revenue.",
    "Budget category 8 is a financial transaction, not new nonfinancial revenue.",
    "The system summary is labelled aggregated and retains internal Social Security transfers; its total revenue is not a consolidated ESA/SEC total."
  ],
  "limitations": [
    "No exact per-contingency bridge from these budget receipts to consolidated ESA/SEC social contributions is supplied.",
    "No breakdown of professional-contingency contribution bases by RG/RETA/Sea/Coal is present in the summary.",
    "Blank cells are stored as null, not fabricated zero; the published total remains authoritative.",
    "2025 common-contingency mutual receipts include a sharp within-year change; neither a permanent future trend nor a specific cause is inferred.",
    "2026 annual figures are a declared allocation of an existing estimate; the observed period is only January through August.",
    "Mutual transfers to TGSS and the corresponding TGSS recognized income can differ because of accounting timing/perimeter. Differences must not become invented flows."
  ],
